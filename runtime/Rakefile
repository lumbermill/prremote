RUNTIME_VERSION = File.read("CMakeLists.txt")[/set\(RUNTIME_VERSION "([^"]+)"\)/, 1]

# gem board label => cmake PICO_BOARD value
BOARDS = {
  'picow' => 'pico_w',
  'pico'  => 'pico'
}.freeze

namespace :build do
  BOARDS.each do |label, cmake_board|
    uf2 = "prremote-#{label}-runtime-#{RUNTIME_VERSION}.uf2"
    desc "Build build/#{label}/#{uf2}"
    task label.to_sym do
      cmake_ensure(label, cmake_board)
      sh "make -C build/#{label} runtime"
      puts "Output: build/#{label}/#{uf2}"
    end
  end
end

desc "Build UF2 for all boards (#{BOARDS.keys.join(', ')})"
task build: BOARDS.keys.map { |b| :"build:#{b}" }

task default: :build

desc "Copy UF2 files for all boards into ~/.prremote/runtime/ (local gem cache)"
task cache: :build do
  cache_dir = File.join(Dir.home, '.prremote', 'runtime')
  mkdir_p cache_dir
  BOARDS.keys.each do |label|
    src = "build/#{label}/prremote-#{label}-runtime-#{RUNTIME_VERSION}.uf2"
    cp src, cache_dir
    puts "Cached: #{File.join(cache_dir, File.basename(src))}"
  end
end

desc "Create draft GitHub release runtime-#{RUNTIME_VERSION} with UF2 assets for all boards"
task release: :build do
  tag    = "runtime-#{RUNTIME_VERSION}"
  title  = "Runtime #{RUNTIME_VERSION}"
  assets = BOARDS.keys.map do |label|
    "build/#{label}/prremote-#{label}-runtime-#{RUNTIME_VERSION}.uf2"
  end

  missing = assets.reject { |f| File.exist?(f) }
  abort "Missing assets:\n#{missing.map { |f| "  #{f}" }.join("\n")}\nRun `rake build` first." unless missing.empty?

  sh "gh release create #{tag} #{assets.join(' ')} --title #{title} --draft --generate-notes"
  puts
  puts "Draft release created. Edit notes and publish at:"
  puts "  https://github.com/lumbermill/prremote/releases/tag/#{tag}"
end

desc "Remove all build directories"
task :clean do
  rm_rf "build"
end

def cmake_init(label, cmake_board)
  mkdir_p "build/#{label}"
  sh "cmake -B build/#{label} -DPICO_BOARD=#{cmake_board}"
end

def cmake_ensure(label, cmake_board)
  makefile = "build/#{label}/Makefile"
  cmake_init(label, cmake_board) if !File.exist?(makefile) ||
                                    File.mtime("CMakeLists.txt") > File.mtime(makefile)
end
